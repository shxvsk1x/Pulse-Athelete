rules_version = '2';
// Pulse security rules. Paste into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function meDoc() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function me() { return get(meDoc()).data; }
    function isCoach() { return signedIn() && exists(meDoc()) && me().role == 'coach'; }
    // a coach may see a student only if they share a school and the coach coaches that sport
    function coachOf(school, sport) { return isCoach() && me().school == school && sport in me().sports; }
    function coachOfAny(school, sports) { return isCoach() && me().school == school && sports.hasAny(me().sports); }

    // schools/{id} = { coachCode: '...' }. Created by the admin in the console. Nobody can read it from the app.
    match /schools/{school} { allow read, write: if false; }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      // students sign up freely; coaches need their school's access code
      allow create: if signedIn() && request.auth.uid == uid && (
        request.resource.data.role == 'student' ||
        (request.resource.data.role == 'coach'
          && exists(/databases/$(database)/documents/schools/$(request.resource.data.school))
          && request.resource.data.coachCode == get(/databases/$(database)/documents/schools/$(request.resource.data.school)).data.coachCode));
      // nobody can change their own role; coaches cannot switch school
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && (resource.data.role == 'student' || request.resource.data.school == resource.data.school);
    }

    // a student's full plan and logs: only the student
    match /states/{uid} { allow read, write: if signedIn() && request.auth.uid == uid; }

    // progress summaries, one per sport: the student writes, that sport's coaches read
    match /progress/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || coachOf(resource.data.school, resource.data.sport));
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid
        && id.matches(request.auth.uid + '_.*') && me().role == 'student';
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // doctors' notes for supplements: the student and their coaches
    match /notes/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || coachOfAny(resource.data.school, resource.data.sports));
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // a coach's decision on a note
    match /reviews/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || coachOfAny(resource.data.school, resource.data.sports));
      allow create, update: if coachOfAny(request.resource.data.school, request.resource.data.sports)
        && request.resource.data.by == request.auth.uid;
    }

    // friends. A friend code is a short random code a student shares; anyone signed in can look one code up, but nobody can list them.
    function pairId(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    function friendsWith(uid) {
      return signedIn() && exists(/databases/$(database)/documents/friendships/$(pairId(request.auth.uid, uid)))
        && get(/databases/$(database)/documents/friendships/$(pairId(request.auth.uid, uid))).data.status == 'accepted';
    }
    match /friendCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && me().role == 'student';
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
    }
    // a friendship has two sides. Either asks, only the other side can accept, and either can end it.
    match /friendships/{id} {
      allow get, list: if signedIn() && (resource.data.a == request.auth.uid || resource.data.b == request.auth.uid);
      allow create: if signedIn() && me().role == 'student'
        && request.resource.data.from == request.auth.uid && request.resource.data.status == 'pending'
        && request.resource.data.a != request.resource.data.b
        && (request.resource.data.a == request.auth.uid || request.resource.data.b == request.auth.uid)
        && id == pairId(request.resource.data.a, request.resource.data.b);
      allow update: if signedIn() && (resource.data.a == request.auth.uid || resource.data.b == request.auth.uid)
        && resource.data.from != request.auth.uid && request.resource.data.status == 'accepted'
        && request.resource.data.a == resource.data.a && request.resource.data.b == resource.data.b && request.resource.data.from == resource.data.from;
      allow delete: if signedIn() && (resource.data.a == request.auth.uid || resource.data.b == request.auth.uid);
    }
    // what a student's accepted friends can see: consistency and progress, nothing about food or body weight
    match /friendFeed/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || friendsWith(uid));
      allow create, update: if signedIn() && uid == request.auth.uid && me().role == 'student';
      allow delete: if signedIn() && uid == request.auth.uid;
    }

    // school events. Titles, criteria and public winners are readable by anyone; only that school's coaches can write.
    match /events/{id} {
      allow read: if true;
      allow create, update: if isCoach() && request.resource.data.school == me().school;
      allow delete: if isCoach() && resource.data.school == me().school;
    }

    // personal results, stored encrypted. The document id is derived from the student's name, ID and date of birth
    // (and access code), so a student can fetch only their own by knowing it. Nobody can list the collection except
    // the school's coaches, who can see only encrypted data.
    match /results/{id} {
      allow get: if signedIn();
      allow list: if isCoach() && resource.data.school == me().school;
      allow create, update: if isCoach() && request.resource.data.school == me().school;
      allow delete: if isCoach() && resource.data.school == me().school;
    }
  }
}
