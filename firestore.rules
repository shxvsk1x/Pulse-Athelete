rules_version = '2';
// Pulse security rules. Paste into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function meDoc() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function me() { return get(meDoc()).data; }
    function isCoach() { return signedIn() && exists(meDoc()) && me().role == 'coach'; }
    // a coach may see a student only if they share a school and the coach coaches that sport
    function coachOf(school, sport) { return isCoach() && me().school == school && sport in me().sports; }
    // admins are added by hand in the console: admins/{uid} with any field. Nobody can create one from the app.
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function coachOfAny(school, sports) { return isCoach() && me().school == school && sports.hasAny(me().sports); }

    // schools/{id} = { coachCode, owner, name }. The first coach to set a school up creates it and picks the code.
    // Only coaches of that school can read the code (to share it with colleagues). Nobody can change or delete it from the app.
    match /admins/{uid} { allow get: if signedIn() && request.auth.uid == uid; allow list, write: if false; }
    match /schools/{school} {
      allow get: if isCoach() && me().school == school;
      allow get, list: if isAdmin();
      allow update: if isAdmin() && request.resource.data.owner == resource.data.owner;
      allow list: if false;
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid
        && request.resource.data.coachCode is string && request.resource.data.coachCode.size() >= 6 && request.resource.data.coachCode.size() <= 40
        && request.resource.data.name is string && request.resource.data.name.size() <= 80;
      allow update, delete: if false;
    }
    // the public list of school names, so a student can pick theirs. Names only, never codes.
    match /schoolDirectory/{school} {
      allow get, list: if true;
      allow create: if signedIn() && exists(/databases/$(database)/documents/schools/$(school))
        && get(/databases/$(database)/documents/schools/$(school)).data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['name']) && request.resource.data.name is string && request.resource.data.name.size() <= 80;
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow list: if isAdmin();
      // students and trainers sign up freely; coaches need their school's access code
      allow create: if signedIn() && request.auth.uid == uid && (
        request.resource.data.role == 'student' || request.resource.data.role == 'trainer' || request.resource.data.role == 'parent' ||
        (request.resource.data.role == 'coach'
          && !get(/databases/$(database)/documents/schools/$(request.resource.data.school)).data.get('suspended', false)
          && exists(/databases/$(database)/documents/schools/$(request.resource.data.school))
          && request.resource.data.coachCode == get(/databases/$(database)/documents/schools/$(request.resource.data.school)).data.coachCode));
      // nobody can change their own role; coaches cannot switch school
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && (resource.data.role == 'student' || request.resource.data.school == resource.data.school);
    }

    // a student's full plan and logs: only the student
    match /states/{uid} { allow read, write: if signedIn() && request.auth.uid == uid; }

    // progress summaries, one per sport: the student writes, that sport's coaches read
    match /progress/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || coachOf(resource.data.school, resource.data.sport));
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid
        && id.matches(request.auth.uid + '_.*') && me().role == 'student'
        && (!(request.resource.data.age is number) || request.resource.data.age >= 18
          || (exists(/databases/$(database)/documents/parentConsents/$(request.auth.uid))
              && get(/databases/$(database)/documents/parentConsents/$(request.auth.uid)).data.status == 'granted'));
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // doctors' notes for supplements: the student and their coaches
    match /notes/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || coachOfAny(resource.data.school, resource.data.sports));
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // a coach's decision on a note
    match /reviews/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || coachOfAny(resource.data.school, resource.data.sports));
      allow create, update: if coachOfAny(request.resource.data.school, request.resource.data.sports)
        && request.resource.data.by == request.auth.uid;
    }

    // friends. A friend code is a short random code a student shares; anyone signed in can look one code up, but nobody can list them.
    function pairId(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    function friendsWith(uid) {
      return signedIn() && exists(/databases/$(database)/documents/friendships/$(pairId(request.auth.uid, uid)))
        && get(/databases/$(database)/documents/friendships/$(pairId(request.auth.uid, uid))).data.status == 'accepted';
    }
    match /friendCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && me().role == 'student';
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
    }
    // a friendship has two sides. Either asks, only the other side can accept, and either can end it.
    match /friendships/{id} {
      allow get, list: if signedIn() && (resource.data.a == request.auth.uid || resource.data.b == request.auth.uid);
      allow create: if signedIn() && me().role == 'student'
        && request.resource.data.from == request.auth.uid && request.resource.data.status == 'pending'
        && request.resource.data.a != request.resource.data.b
        && (request.resource.data.a == request.auth.uid || request.resource.data.b == request.auth.uid)
        && id == pairId(request.resource.data.a, request.resource.data.b);
      allow update: if signedIn() && (resource.data.a == request.auth.uid || resource.data.b == request.auth.uid)
        && resource.data.from != request.auth.uid && request.resource.data.status == 'accepted'
        && request.resource.data.a == resource.data.a && request.resource.data.b == resource.data.b && request.resource.data.from == resource.data.from;
      allow delete: if signedIn() && (resource.data.a == request.auth.uid || resource.data.b == request.auth.uid);
    }
    // what a student's accepted friends can see: consistency and progress, nothing about food or body weight
    match /friendFeed/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || friendsWith(uid));
      allow create, update: if signedIn() && uid == request.auth.uid && me().role == 'student';
      allow delete: if signedIn() && uid == request.auth.uid;
    }

    // personal trainers. A trainee shares a code, a trainer with a verified email enters it, and the trainee must accept.
    // Only then can the trainer read the trainee's progress summary. Either side can end it at any time.
    function linkedTrainer(traineeUid) {
      return signedIn() && exists(/databases/$(database)/documents/trainerLinks/$(request.auth.uid + '_' + traineeUid))
        && get(/databases/$(database)/documents/trainerLinks/$(request.auth.uid + '_' + traineeUid)).data.status == 'accepted';
    }
    match /trainerCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && me().role == 'student';
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
    }
    match /trainerLinks/{id} {
      allow get, list: if signedIn() && (resource.data.trainer == request.auth.uid || resource.data.trainee == request.auth.uid);
      allow create: if signedIn() && me().role == 'trainer' && request.auth.token.email_verified == true
        && request.resource.data.trainer == request.auth.uid && request.resource.data.status == 'pending'
        && request.resource.data.trainerEmail == request.auth.token.email
        && id == request.auth.uid + '_' + request.resource.data.trainee;
      allow update: if signedIn() && resource.data.trainee == request.auth.uid && request.resource.data.status == 'accepted'
        && request.resource.data.trainer == resource.data.trainer && request.resource.data.trainee == resource.data.trainee
        && request.resource.data.trainerEmail == resource.data.trainerEmail;
      allow delete: if signedIn() && (resource.data.trainer == request.auth.uid || resource.data.trainee == request.auth.uid);
    }
    match /trainee/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || linkedTrainer(uid));
      allow create, update: if signedIn() && uid == request.auth.uid && me().role == 'student';
      allow delete: if signedIn() && uid == request.auth.uid;
    }

    // school events. Titles, criteria and public winners are readable by anyone; only that school's coaches can write.
    match /events/{id} {
      allow read: if true;
      allow create, update: if isCoach() && request.resource.data.school == me().school;
      allow delete: if isCoach() && resource.data.school == me().school;
    }

    // personal results, stored encrypted. The document id is derived from the student's name, ID and date of birth
    // (and access code), so a student can fetch only their own by knowing it. Nobody can list the collection except
    // the school's coaches, who can see only encrypted data.
    // results login (student ID + password). A student verifies their email, then registers a lookup so the ID can be typed in place of the email.
    // The lookup holds only the email the ID belongs to; anyone may fetch one by its exact ID, nobody may list them.
    match /resultLogins/{id} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && request.auth.token.email_verified == true
        && request.resource.data.uid == request.auth.uid && request.resource.data.email == request.auth.token.email;
      allow update: if signedIn() && request.auth.token.email_verified == true && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid && request.resource.data.email == request.auth.token.email;
      // the owner can remove it, and so can a coach of that school (to free up an ID someone took by mistake)
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || (isCoach() && resource.data.school == me().school));
    }
    // a student's result for a personal event, readable only by the verified email on the school's list. Coaches manage their school's.
    match /loginResults/{id} {
      allow get: if signedIn() && request.auth.token.email_verified == true && resource.data.email == request.auth.token.email;
      allow list: if isCoach() && resource.data.school == me().school;
      allow create, update: if isCoach() && request.resource.data.school == me().school;
      allow delete: if isCoach() && resource.data.school == me().school;
    }

    // parent or guardian consent for a student under 18. The student asks (pending); only a parent account with a verified
    // email that matches the address given can grant, decline or revoke. The student cannot grant it themselves.
    match /parentConsents/{child} {
      allow create: if signedIn() && child == request.auth.uid && me().role == 'student' && request.resource.data.child == request.auth.uid
        && request.resource.data.status == 'pending' && request.resource.data.parentEmail is string && request.resource.data.parentEmail != request.auth.token.email;
      allow get: if signedIn() && (child == request.auth.uid
        || (request.auth.token.email_verified == true && resource.data.parentEmail == request.auth.token.email));
      allow list: if signedIn() && request.auth.token.email_verified == true && resource.data.parentEmail == request.auth.token.email;
      allow update: if signedIn() && me().role == 'parent' && request.auth.token.email_verified == true && resource.data.parentEmail == request.auth.token.email
        && request.resource.data.child == resource.data.child && request.resource.data.parentEmail == resource.data.parentEmail
        && request.resource.data.status in ['granted', 'declined', 'revoked'];
      allow delete: if signedIn() && child == request.auth.uid;
    }
    // reports: anyone signed in can file one about a message, person or entry; only the reporter and admins can read it
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.by == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() <= 800;
      allow get: if signedIn() && resource.data.by == request.auth.uid;
      allow get, list: if isAdmin();
      allow update: if isAdmin();
    }
    // coach <-> student messages, same school only
    match /messages/{id} {
      allow create: if signedIn() && request.resource.data.from == request.auth.uid && exists(meDoc())
        && request.resource.data.school == me().school && request.resource.data.text is string && request.resource.data.text.size() <= 600
        && (me().role == 'coach' || me().role == 'student');
      allow get, list: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      // the recipient can mark it read, nothing else
      allow update: if signedIn() && resource.data.to == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
    }
    // leaderboard. A student claims a lift; a coach at the same school verifies it; only then does it reach the board.
    match /lifts/{id} {
      allow create: if signedIn() && me().role == 'student' && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending' && request.resource.data.school == me().school;
      allow get, list: if signedIn() && (resource.data.uid == request.auth.uid || (isCoach() && me().school == resource.data.school));
      // a coach decides it; the student can only switch their own consent
      allow update: if signedIn() && ((isCoach() && me().school == resource.data.school && request.resource.data.uid == resource.data.uid)
        || (resource.data.uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['consent'])));
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    // the proof link (video): the student and their school's coaches only. Never shown on the board.
    match /liftProof/{id} {
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.url is string && request.resource.data.url.size() <= 300;
      allow get: if signedIn() && (resource.data.uid == request.auth.uid || (isCoach() && me().school == resource.data.school));
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    // board entries: name, school, grade, weight. A coach adds one at verification; the student can re-post their own verified lift or remove it.
    match /board/{id} {
      allow get, list: if signedIn();
      allow create, update: if signedIn() && request.resource.data.consent == true && (
        (isCoach() && me().school == request.resource.data.school && request.resource.data.verifiedBy == request.auth.uid)
        || (request.resource.data.uid == request.auth.uid
          && get(/databases/$(database)/documents/lifts/$(request.resource.data.liftId)).data.status == 'verified'
          && get(/databases/$(database)/documents/lifts/$(request.resource.data.liftId)).data.uid == request.auth.uid
          && get(/databases/$(database)/documents/lifts/$(request.resource.data.liftId)).data.kg == request.resource.data.kg));
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /results/{id} {
      allow get: if signedIn();
      allow list: if isCoach() && resource.data.school == me().school;
      allow create, update: if isCoach() && request.resource.data.school == me().school;
      allow delete: if isCoach() && resource.data.school == me().school;
    }
  }
}
